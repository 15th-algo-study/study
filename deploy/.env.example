# 이 파일을 deploy/.env 로 복사해서 수정하세요.

# 접속 주소. 도메인이 없으면 서버 공인 IP 로 sslip.io 주소를 쓸 수 있습니다 (예: IP 1.2.3.4 → 1-2-3-4.sslip.io)
DOMAIN=study.example.com

# 동시에 돌리는 채점 수. 채점 하나에 메모리 최대 약 1.2 GB — 4 GB 서버는 1~2, 8 GB 서버는 2~4 (vCPU 수를 넘지 않게)
RUNNER_SLOTS=1

# 앱 컨테이너 메모리 상한 — 4 GB 서버 3g, 8 GB 서버 6g
APP_MEM_LIMIT=3g

# origin/main(새 문제·다른 사람 풀이)을 받아 오는 주기(분)
SYNC_INTERVAL_MIN=5
